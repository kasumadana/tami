# ==============================================================================
# tami (Teman Aman Media Internet) — Environment Variables Template
# Copy this file to .env.local: cp .env.example .env.local
# ==============================================================================

# --- [1. REQUIRED] AI ENGINE (Google Gemini 3.7 Flash via LangChain) ---
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...your_gemini_api_key

# --- [2. REQUIRED] CLOUD DATABASE (Neon Serverless PostgreSQL) ---
# Get your pooled connection string from: https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- [3. REQUIRED] AUTHENTICATION SECRETS (NextAuth v5 & Guest Sessions) ---
# Secret used to encrypt user JWT sessions (NextAuth v5 standard).
# Generate via: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
AUTH_SECRET=tami_super_secret_jwt_key_2026_bali_fest

# Secret used for HMAC signing of guest quota cookies (anti-tampering)
# Generate via: `openssl rand -base64 32`
GUEST_COOKIE_SECRET=tami-super-secret-guest-signing-key-2026

# Base URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- [4. OPTIONAL] GOOGLE OAUTH 2.0 (Only if Google Sign-In is enabled) ---
# Setup in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# (Leave empty if only using Guest Mode and 1-Click Demo Student)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=